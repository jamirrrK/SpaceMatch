* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
# Deployment scripts must use Unix line endings on cPanel/Linux.
scripts/deploy/*.sh text eol=lf
scripts/deploy/*.py text eol=lf
.github/workflows/*.yml text eol=lf

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=be87b4001@smtp-brevo.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=spacematchhaha@gmail.com
MAIL_FROM_NAME="SpaceMatch"

# Enable OTP email only after configuring a real SMTP/API transport or local test inbox.
OTP_EMAIL_ENABLED=false
# Configure a real SMTP/API mailer before enabling email OTP outside tests.
# SMS OTP remains disabled until an authorized provider adapter is configured.
SMS_OTP_ENABLED=false
SMS_OTP_DRIVER=
SMS_OTP_API_KEY=
SMS_OTP_SENDER_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
MAIL_AUTO_TLS=true
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=15
BREVO_SENDER_VERIFIED=false
BREVO_VERIFIED_SENDER=
MAIL_URL=null
